<?xml version="1.0" encoding="utf-8"?>
<!-- KLayout layer properties (.lyp) — SKY130 starter set for the UWASIC two-stage op-amp.
     Prepared 2026-11-02 for M1 (NMOS diff pair) drawing in KLayout 0.30.4.
     Layer/datatype numbers verified 2026-11-01 against the SKY130 PDK layer table:
       diff 65/20, poly 66/20, nsdm 93/44, psdm 94/20, npc 95/20, licon1 66/44,
       li1 67/20, mcon 67/44, met1 68/20, met2 69/20, met3 70/20,
       met4 71/20, met4 pin 71/16, prBoundary 235/4.
     How to use: in KLayout, File > Load Layer Properties (or right-click the
     Layers panel > Load Layer Properties), select this file. The layers then
     appear in the panel even though they have no shapes yet. This file only
     names/colors layers — it does not create shapes, run DRC, or change the GDS.
     If the SKY130 technology already loaded successfully, this file is not needed.
     Colors are display-only; DRC/LVS read the layer/datatype numbers, not colors. -->
<layer-properties>
 <properties>
  <frame-color>#00a000</frame-color>
  <fill-color>#00a000</fill-color>
  <frame-brightness>0</frame-brightness>
  <fill-brightness>0</fill-brightness>
  <dither-pattern>I0</dither-pattern>
  <valid>true</valid>
  <visible>true</visible>
  <transparent>false</transparent>
  <width>1</width>
  <marked>false</marked>
  <xfill>false</xfill>
  <animation>0</animation>
  <name>diff</name>
  <source>65/20@1</source>
 </properties>
 <properties>
  <frame-color>#ff0000</frame-color>
  <fill-color>#ff0000</fill-color>
  <frame-brightness>0</frame-brightness>
